import { Tokens } from "../tokens.slint";
export { Tokens }

export struct AppEntry {
    id: string,
    name: string,
    path: string,
    icon: image,
    has-icon: bool,
    locked: bool,
    grace-seconds: int,
    mode-label: string,
}

export component ManagerWindow inherits Window {
    // Gate state
    in property <bool> unlocked: false;
    in property <string> gate-prompt: "Enter your PIN or password to open AppLock Manager.";
    in property <string> pin-placeholder: "PIN or password";
    in property <string> unlock-label: "Unlock";
    in property <string> gate-error: "";
    in-out property <string> gate-pin: "";

    // Navigation & labels
    in property <string> window-title: "AppLock Manager";
    in-out property <int> active-tab: 0;
    in property <string> tab-apps-label: "Apps";
    in property <string> tab-security-label: "Security";
    in property <string> tab-limits-label: "Honest limits";

    // Apps tab
    in property <[AppEntry]> apps: [];
    in property <string> search-placeholder: "Search apps";
    in-out property <string> search-query: "";
    in property <string> add-placeholder: "Add executable (for example: whatsapp.exe)";
    in-out property <string> add-input: "";
    in property <string> add-button-label: "Lock app";
    in property <string> browse-button-label: "Browse .exe";
    in property <string> loading-apps-label: "Scanning installed apps...";
    in property <bool> loading-apps: false;
    in property <string> empty-apps-label: "No matching apps found.";
    in property <string> locked-label: "Locked";
    in property <string> unlocked-label: "Unlocked";

    // Security tab
    in property <string> current-pin-label: "Current PIN or password";
    in property <string> new-pin-label: "New PIN or password (at least 4 characters)";
    in property <string> confirm-pin-label: "Confirm new PIN or password";
    in property <string> save-pin-label: "Save new PIN";
    in-out property <string> current-pin-input: "";
    in-out property <string> new-pin-input: "";
    in-out property <string> confirm-pin-input: "";
    in property <string> security-status: "";
    in property <bool> security-is-error: false;
    in property <string> lang-label: "Language";
    in property <string> theme-label: "Dark theme";

    // Limits tab
    in property <string> limits-intro: "";
    in property <string> limits-admin: "";
    in property <string> limits-safemode: "";
    in property <string> limits-disk: "";

    callback gate-submitted(string);
    callback search-changed(string);
    callback add-app-submitted(string);
    callback browse-exe-clicked();
    callback toggle-app(string, bool);
    callback cycle-app-mode(string, int);
    callback change-pin-submitted(string, string, string);
    callback toggle-language();
    callback toggle-theme();

    title: root.window-title;
    min-width: 680px;
    min-height: 460px;
    preferred-width: 760px;
    preferred-height: 520px;
    background: Tokens.bg;
    default-font-family: Tokens.font-family;

    if !root.unlocked: Rectangle {
        width: 100%;
        height: 100%;
        background: Tokens.bg;

        Rectangle {
            width: 400px;
            height: 230px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Tokens.surface;
            border-color: Tokens.border;
            border-width: 1px;
            border-radius: Tokens.radius-dialog;

            VerticalLayout {
                padding: Tokens.space-lg;
                spacing: Tokens.space-md;

                Text {
                    text: root.window-title;
                    color: Tokens.text;
                    font-size: Tokens.font-title;
                    font-weight: 600;
                    horizontal-alignment: Tokens.rtl ? right : left;
                }

                Text {
                    text: root.gate-prompt;
                    color: Tokens.text-muted;
                    font-size: Tokens.font-body;
                    wrap: word-wrap;
                    horizontal-alignment: Tokens.rtl ? right : left;
                }

                Rectangle {
                    height: 38px;
                    background: Tokens.surface;
                    border-radius: Tokens.radius-control;
                    border-width: gate-field.has-focus || root.gate-error != "" ? Tokens.focus-ring : 1px;
                    border-color: root.gate-error != "" ? Tokens.danger : (gate-field.has-focus ? Tokens.accent : Tokens.border);

                    gate-field := TextInput {
                        x: Tokens.space-sm;
                        width: parent.width - Tokens.space-sm * 2;
                        height: 100%;
                        text <=> root.gate-pin;
                        input-type: password;
                        color: Tokens.text;
                        font-size: Tokens.font-body;
                        vertical-alignment: center;
                        horizontal-alignment: Tokens.rtl ? right : left;
                        accepted => {
                            root.gate-submitted(root.gate-pin);
                        }
                    }

                    if root.gate-pin == "": Text {
                        x: Tokens.space-sm;
                        width: parent.width - Tokens.space-sm * 2;
                        height: 100%;
                        text: root.pin-placeholder;
                        color: Tokens.text-muted;
                        font-size: Tokens.font-body;
                        vertical-alignment: center;
                        horizontal-alignment: Tokens.rtl ? right : left;
                    }
                }

                if root.gate-error != "": Text {
                    text: root.gate-error;
                    color: Tokens.danger;
                    font-size: Tokens.font-caption;
                    wrap: word-wrap;
                    horizontal-alignment: Tokens.rtl ? right : left;
                }

                Rectangle {
                    height: 38px;
                    border-radius: Tokens.radius-control;
                    background: gate-btn-touch.pressed ? Tokens.text : Tokens.accent;
                    border-width: gate-btn-focus.has-focus ? Tokens.focus-ring : 0px;
                    border-color: Tokens.text;

                    gate-btn-focus := FocusScope {
                        key-pressed(event) => {
                            if (event.text == Key.Return || event.text == " ") {
                                root.gate-submitted(root.gate-pin);
                                accept
                            }
                            reject
                        }
                    }

                    gate-btn-touch := TouchArea {
                        clicked => {
                            root.gate-submitted(root.gate-pin);
                        }
                    }

                    Text {
                        text: root.unlock-label;
                        color: Tokens.on-accent;
                        font-size: Tokens.font-body;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }

    if root.unlocked: HorizontalLayout {
        width: 100%;
        height: 100%;

        // Sidebar
        Rectangle {
            width: 190px;
            background: Tokens.surface;
            border-color: Tokens.border;
            border-width: 1px;

            VerticalLayout {
                padding: Tokens.space-md;
                spacing: Tokens.space-sm;
                alignment: start;

                Text {
                    text: root.window-title;
                    color: Tokens.text;
                    font-size: Tokens.font-title;
                    font-weight: 600;
                    horizontal-alignment: Tokens.rtl ? right : left;
                }

                Rectangle { height: Tokens.space-sm; }

                for nav in [
                    { idx: 0, label: root.tab-apps-label },
                    { idx: 1, label: root.tab-security-label },
                    { idx: 2, label: root.tab-limits-label },
                ]: Rectangle {
                    height: 36px;
                    border-radius: Tokens.radius-control;
                    background: root.active-tab == nav.idx ? Tokens.accent : (nav-touch.has-hover ? Tokens.bg : transparent);
                    border-width: nav-focus.has-focus ? Tokens.focus-ring : 0px;
                    border-color: Tokens.accent;

                    nav-focus := FocusScope {
                        key-pressed(event) => {
                            if (event.text == Key.Return || event.text == " ") {
                                root.active-tab = nav.idx;
                                accept
                            }
                            reject
                        }
                    }

                    nav-touch := TouchArea {
                        clicked => {
                            root.active-tab = nav.idx;
                        }
                    }

                    Text {
                        x: Tokens.space-sm;
                        width: parent.width - Tokens.space-sm * 2;
                        height: 100%;
                        text: nav.label;
                        color: root.active-tab == nav.idx ? Tokens.on-accent : Tokens.text;
                        font-size: Tokens.font-body;
                        font-weight: root.active-tab == nav.idx ? 600 : 400;
                        vertical-alignment: center;
                        horizontal-alignment: Tokens.rtl ? right : left;
                    }
                }
            }
        }

        // Main content area
        Rectangle {
            background: Tokens.bg;

            // Tab 0: Apps
            if root.active-tab == 0: VerticalLayout {
                padding: Tokens.space-lg;
                spacing: Tokens.space-md;
                alignment: start;

                // Search bar + Browse .exe fallback
                HorizontalLayout {
                    spacing: Tokens.space-sm;

                    Rectangle {
                        height: 36px;
                        background: Tokens.surface;
                        border-radius: Tokens.radius-control;
                        border-width: search-input-box.has-focus ? Tokens.focus-ring : 1px;
                        border-color: search-input-box.has-focus ? Tokens.accent : Tokens.border;

                        search-input-box := TextInput {
                            x: Tokens.space-sm;
                            width: parent.width - Tokens.space-sm * 2;
                            height: 100%;
                            text <=> root.search-query;
                            color: Tokens.text;
                            font-size: Tokens.font-body;
                            vertical-alignment: center;
                            horizontal-alignment: Tokens.rtl ? right : left;
                            edited => {
                                root.search-changed(self.text);
                            }
                        }

                        if root.search-query == "": Text {
                            x: Tokens.space-sm;
                            width: parent.width - Tokens.space-sm * 2;
                            height: 100%;
                            text: root.search-placeholder;
                            color: Tokens.text-muted;
                            font-size: Tokens.font-body;
                            vertical-alignment: center;
                            horizontal-alignment: Tokens.rtl ? right : left;
                        }
                    }

                    Rectangle {
                        width: 120px;
                        height: 36px;
                        border-radius: Tokens.radius-control;
                        background: browse-btn-touch.pressed ? Tokens.border : (browse-btn-touch.has-hover ? Tokens.bg : Tokens.surface);
                        border-color: browse-btn-focus.has-focus ? Tokens.accent : Tokens.border;
                        border-width: browse-btn-focus.has-focus ? Tokens.focus-ring : 1px;
                        accessible-role: button;
                        accessible-label: root.browse-button-label;

                        browse-btn-focus := FocusScope {
                            key-pressed(event) => {
                                if (event.text == Key.Return || event.text == " ") {
                                    root.browse-exe-clicked();
                                    accept
                                }
                                reject
                            }
                        }

                        browse-btn-touch := TouchArea {
                            clicked => {
                                root.browse-exe-clicked();
                            }
                        }

                        Text {
                            text: root.browse-button-label;
                            color: Tokens.text;
                            font-size: Tokens.font-caption;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }

                if root.loading-apps: Rectangle {
                    height: 44px;
                    background: Tokens.surface;
                    border-color: Tokens.border;
                    border-width: 1px;
                    border-radius: Tokens.radius-control;

                    Text {
                        x: Tokens.space-md;
                        width: parent.width - Tokens.space-md * 2;
                        height: 100%;
                        text: root.loading-apps-label;
                        color: Tokens.text-muted;
                        font-size: Tokens.font-body;
                        vertical-alignment: center;
                        horizontal-alignment: Tokens.rtl ? right : left;
                    }
                }

                // Empty state
                if !root.loading-apps && root.apps.length == 0: Rectangle {
                    height: 64px;
                    background: Tokens.surface;
                    border-color: Tokens.border;
                    border-width: 1px;
                    border-radius: Tokens.radius-control;

                    Text {
                        x: Tokens.space-md;
                        width: parent.width - Tokens.space-md * 2;
                        height: 100%;
                        text: root.empty-apps-label;
                        color: Tokens.text-muted;
                        font-size: Tokens.font-body;
                        vertical-alignment: center;
                        horizontal-alignment: Tokens.rtl ? right : left;
                    }
                }

                // Scrollable installed-apps list
                Flickable {
                    vertical-stretch: 1;
                    viewport-height: apps-col.preferred-height;

                    apps-col := VerticalLayout {
                        width: parent.width;
                        spacing: Tokens.space-xs;
                        alignment: start;

                        for entry in root.apps: Rectangle {
                            height: 56px;
                            background: Tokens.surface;
                            border-color: Tokens.border;
                            border-width: 1px;
                            border-radius: Tokens.radius-control;

                            HorizontalLayout {
                                padding-left: Tokens.space-md;
                                padding-right: Tokens.space-md;
                                spacing: Tokens.space-sm;

                                // Real app icon or fallback badge
                                Rectangle {
                                    width: 32px;
                                    height: 32px;
                                    y: 12px;
                                    border-radius: Tokens.radius-control;
                                    background: Tokens.bg;
                                    border-color: Tokens.border;
                                    border-width: entry.has-icon ? 0px : 1px;

                                    if entry.has-icon: Image {
                                        width: 32px;
                                        height: 32px;
                                        source: entry.icon;
                                        image-fit: contain;
                                    }

                                    if !entry.has-icon: Text {
                                        text: "A";
                                        color: Tokens.text-muted;
                                        font-size: Tokens.font-body;
                                        font-weight: 600;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }

                                // Display name + exe path / AUMID
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    alignment: center;
                                    spacing: 2px;

                                    Text {
                                        text: entry.name;
                                        color: Tokens.text;
                                        font-size: Tokens.font-body;
                                        font-weight: 600;
                                        overflow: elide;
                                        horizontal-alignment: Tokens.rtl ? right : left;
                                    }

                                    Text {
                                        text: entry.path;
                                        color: Tokens.text-muted;
                                        font-size: Tokens.font-caption;
                                        overflow: elide;
                                        horizontal-alignment: Tokens.rtl ? right : left;
                                    }
                                }

                                // Grace / mode pill (visible when locked)
                                if entry.locked: Rectangle {
                                    width: 64px;
                                    height: 30px;
                                    y: 13px;
                                    border-radius: Tokens.radius-control;
                                    background: Tokens.bg;
                                    border-color: Tokens.border;
                                    border-width: 1px;
                                    accessible-role: button;
                                    accessible-label: entry.mode-label;

                                    TouchArea {
                                        clicked => {
                                            root.cycle-app-mode(entry.id, entry.grace-seconds);
                                        }
                                    }

                                    Text {
                                        text: entry.mode-label;
                                        color: Tokens.text-muted;
                                        font-size: Tokens.font-caption;
                                        font-weight: 600;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }

                                // Instant Lock / Unlock toggle
                                Rectangle {
                                    width: 96px;
                                    height: 30px;
                                    y: 13px;
                                    border-radius: Tokens.radius-control;
                                    background: entry.locked ? Tokens.accent : Tokens.bg;
                                    border-color: toggle-focus.has-focus ? Tokens.text : Tokens.border;
                                    border-width: toggle-focus.has-focus ? Tokens.focus-ring : (entry.locked ? 0px : 1px);
                                    accessible-role: button;
                                    accessible-label: entry.name;

                                    toggle-focus := FocusScope {
                                        key-pressed(event) => {
                                            if (event.text == Key.Return || event.text == " ") {
                                                root.toggle-app(entry.id, !entry.locked);
                                                accept
                                            }
                                            reject
                                        }
                                    }

                                    TouchArea {
                                        clicked => {
                                            root.toggle-app(entry.id, !entry.locked);
                                        }
                                    }

                                    Text {
                                        text: entry.locked ? root.locked-label : root.unlocked-label;
                                        color: entry.locked ? Tokens.on-accent : Tokens.text;
                                        font-size: Tokens.font-caption;
                                        font-weight: 600;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // Tab 1: Security
            if root.active-tab == 1: VerticalLayout {
                padding: Tokens.space-lg;
                spacing: Tokens.space-md;
                alignment: start;

                Text {
                    text: root.tab-security-label;
                    color: Tokens.text;
                    font-size: Tokens.font-title;
                    font-weight: 600;
                    horizontal-alignment: Tokens.rtl ? right : left;
                }

                Rectangle {
                    height: 36px;
                    background: Tokens.surface;
                    border-radius: Tokens.radius-control;
                    border-width: curr-pin.has-focus ? Tokens.focus-ring : 1px;
                    border-color: curr-pin.has-focus ? Tokens.accent : Tokens.border;

                    curr-pin := TextInput {
                        x: Tokens.space-sm;
                        width: parent.width - Tokens.space-sm * 2;
                        height: 100%;
                        text <=> root.current-pin-input;
                        input-type: password;
                        color: Tokens.text;
                        font-size: Tokens.font-body;
                        vertical-alignment: center;
                        horizontal-alignment: Tokens.rtl ? right : left;
                    }

                    if root.current-pin-input == "": Text {
                        x: Tokens.space-sm;
                        width: parent.width - Tokens.space-sm * 2;
                        height: 100%;
                        text: root.current-pin-label;
                        color: Tokens.text-muted;
                        font-size: Tokens.font-body;
                        vertical-alignment: center;
                        horizontal-alignment: Tokens.rtl ? right : left;
                    }
                }

                Rectangle {
                    height: 36px;
                    background: Tokens.surface;
                    border-radius: Tokens.radius-control;
                    border-width: new-pin.has-focus ? Tokens.focus-ring : 1px;
                    border-color: new-pin.has-focus ? Tokens.accent : Tokens.border;

                    new-pin := TextInput {
                        x: Tokens.space-sm;
                        width: parent.width - Tokens.space-sm * 2;
                        height: 100%;
                        text <=> root.new-pin-input;
                        input-type: password;
                        color: Tokens.text;
                        font-size: Tokens.font-body;
                        vertical-alignment: center;
                        horizontal-alignment: Tokens.rtl ? right : left;
                    }

                    if root.new-pin-input == "": Text {
                        x: Tokens.space-sm;
                        width: parent.width - Tokens.space-sm * 2;
                        height: 100%;
                        text: root.new-pin-label;
                        color: Tokens.text-muted;
                        font-size: Tokens.font-body;
                        vertical-alignment: center;
                        horizontal-alignment: Tokens.rtl ? right : left;
                    }
                }

                Rectangle {
                    height: 36px;
                    background: Tokens.surface;
                    border-radius: Tokens.radius-control;
                    border-width: conf-pin.has-focus ? Tokens.focus-ring : 1px;
                    border-color: conf-pin.has-focus ? Tokens.accent : Tokens.border;

                    conf-pin := TextInput {
                        x: Tokens.space-sm;
                        width: parent.width - Tokens.space-sm * 2;
                        height: 100%;
                        text <=> root.confirm-pin-input;
                        input-type: password;
                        color: Tokens.text;
                        font-size: Tokens.font-body;
                        vertical-alignment: center;
                        horizontal-alignment: Tokens.rtl ? right : left;
                    }

                    if root.confirm-pin-input == "": Text {
                        x: Tokens.space-sm;
                        width: parent.width - Tokens.space-sm * 2;
                        height: 100%;
                        text: root.confirm-pin-label;
                        color: Tokens.text-muted;
                        font-size: Tokens.font-body;
                        vertical-alignment: center;
                        horizontal-alignment: Tokens.rtl ? right : left;
                    }
                }

                if root.security-status != "": Text {
                    text: root.security-status;
                    color: root.security-is-error ? Tokens.danger : Tokens.accent;
                    font-size: Tokens.font-caption;
                    wrap: word-wrap;
                    horizontal-alignment: Tokens.rtl ? right : left;
                }

                HorizontalLayout {
                    spacing: Tokens.space-sm;

                    Rectangle {
                        width: 150px;
                        height: 36px;
                        border-radius: Tokens.radius-control;
                        background: Tokens.accent;

                        TouchArea {
                            clicked => {
                                root.change-pin-submitted(
                                    root.current-pin-input,
                                    root.new-pin-input,
                                    root.confirm-pin-input,
                                );
                            }
                        }

                        Text {
                            text: root.save-pin-label;
                            color: Tokens.on-accent;
                            font-size: Tokens.font-body;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    Rectangle {
                        width: 130px;
                        height: 36px;
                        border-radius: Tokens.radius-control;
                        background: Tokens.surface;
                        border-color: Tokens.border;
                        border-width: 1px;

                        TouchArea {
                            clicked => {
                                root.toggle-language();
                            }
                        }

                        Text {
                            text: root.lang-label + ": " + (Tokens.rtl ? "اردو" : "EN");
                            color: Tokens.text;
                            font-size: Tokens.font-body;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    Rectangle {
                        width: 130px;
                        height: 36px;
                        border-radius: Tokens.radius-control;
                        background: Tokens.surface;
                        border-color: Tokens.border;
                        border-width: 1px;

                        TouchArea {
                            clicked => {
                                root.toggle-theme();
                            }
                        }

                        Text {
                            text: root.theme-label;
                            color: Tokens.text;
                            font-size: Tokens.font-body;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            // Tab 2: Honest limits
            if root.active-tab == 2: VerticalLayout {
                padding: Tokens.space-lg;
                spacing: Tokens.space-md;
                alignment: start;

                Text {
                    text: root.tab-limits-label;
                    color: Tokens.text;
                    font-size: Tokens.font-title;
                    font-weight: 600;
                    horizontal-alignment: Tokens.rtl ? right : left;
                }

                Text {
                    text: root.limits-intro;
                    color: Tokens.text;
                    font-size: Tokens.font-body;
                    wrap: word-wrap;
                    horizontal-alignment: Tokens.rtl ? right : left;
                }

                for item in [root.limits-admin, root.limits-safemode, root.limits-disk]: Rectangle {
                    height: 44px;
                    background: Tokens.surface;
                    border-color: Tokens.border;
                    border-width: 1px;
                    border-radius: Tokens.radius-control;

                    Text {
                        x: Tokens.space-md;
                        width: parent.width - Tokens.space-md * 2;
                        height: 100%;
                        text: item;
                        color: Tokens.text-muted;
                        font-size: Tokens.font-body;
                        wrap: word-wrap;
                        vertical-alignment: center;
                        horizontal-alignment: Tokens.rtl ? right : left;
                    }
                }
            }
        }
    }
}
